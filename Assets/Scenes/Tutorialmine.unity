    autoDismissDuration: 5
  - message: Hold a direction key to plant a flag on a suspected mine.
    triggerToDismiss: 2
    autoDismissDuration: 0
  - message: Clear all mines and monsters to open the exit portal!
    triggerToDismiss: 4
    autoDismissDuration: 5
